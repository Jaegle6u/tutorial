---
import BaseLayout from "../layouts/BaseLayout.astro";
import maTeteFace from '../images/maTeteFace.jpg';
import { Image } from "astro:assets";
const pageTitle = "A propos de moi";
const identity = {
	firstname: "Loïc JAEGLE",
	country: "France",
	occupation: "Développeur web",
	hobbies: ["Trail", "Cuisine", "Programmation"],
};
const skills = [
	"HTML",
	"CSS",
	"JavaScript",
	"TypeScript",
	"React",
	"SQL",
	"Node.js",
	"Astro",
	"PHP"
];
const happy = true;
const finished = true;
const goal = 3;

const skillColor ="crimson";
const fontWeight ="bold";
const textCase = "uppercase";
---
<BaseLayout pageTitle={pageTitle}>
	<style  define:vars={{skillColor, fontWeight, textCase}}>
			
			.skill{
				color: var(--skillColor);
				font-weight: var(--fontWeight);
				text-transform: var(--textCase);
			}
			#identite{
				display: flex;
				gap: 1rem;
				
				
			}
	</style>
	<div id="identite">
		
		<div>
			<p>Petites informations me concernant :</p>
        <ul>
            <li>Je m'appelle {identity.firstname}.</li>
            <li>Je vis en {identity.country} et je suis {identity.occupation}.</li>
            {identity.hobbies.length >= 2 &&
                <li>Deux de mes loisirs sont : {identity.hobbies[0]} et {identity.hobbies[1]}</li>
            }
            
        </ul>
		</div>
		<Image src={maTeteFace} alt="Ma tronche" width="100" />
	</div>
	
	
        <p>Voici mes compétences :</p>
        <ul>
            {skills.map((skill) => (
                <li class="skill">{skill}</li>
            ))}
        </ul>
		{happy && <p>Je suis heureux d'apprendre 	Astro !</p>}
		{finished && <p>J'ai terminé ce tutoriel</p>}
		<p>Je me sers de ce site pour apprendre à utiliser Astro donc c'est normal que c'est moche !!!</p>
</BaseLayout>
		
	
