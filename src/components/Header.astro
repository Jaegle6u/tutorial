---
import Navigation from "./Navigation.astro";
import Menu  from "./Menu.astro";
import ThemeIcon  from "./ThemeIcon.astro";
---

<header>
    <nav>
      <h1 id="h1_header">Mon Blog Test</h1>
        <Navigation />
        <ThemeIcon />
          <Menu /> 
    </nav>
</header>

<style>
  header{
    padding-left: 1rem;
    padding-right: 1rem;
    position: sticky;
    top: 0px;
    background-color: blueviolet;
    /*box-shadow: 0px 5px 7px -3px #5E5E5E;*/
    color: white;
  }
  
  nav {
    display: flex;
    flex-wrap: nowrap;
    justify-content: space-between;
    align-items: center;
  }
  
</style>